{
  "name": "nabu-brainstorm",
  "version": "1.13.1",
  "description": "NabuBrainstorm – standalone visual brainstorm board",
  "main": "main.js",
  "author": "Shitiz Srivastava",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "powershell -ExecutionPolicy Bypass -File release.ps1"
  },
  "build": {
    "appId": "com.shitiz.nabubrainstorm",
    "productName": "NabuBrainstorm",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "board.html",
      "main.js",
      "preload.js",
      "phone.html",
      "package.json",
      "assets/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "NabuBrainstorm"
    },
    "publish": {
      "provider": "github",
      "owner": "shitizsrivastava",
      "repo": "nabubrainstorm"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.30.0",
    "qrcode": "^1.5.4"
  }
}
